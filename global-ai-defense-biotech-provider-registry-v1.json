  "normalizedAuthentication": {
    "API_KEY": {
      "secretStorage": "SERVER_ENVIRONMENT",
      "browserExposure": false
    },

    "BEARER_TOKEN": {
      "secretStorage": "SERVER_ENVIRONMENT",
      "browserExposure": false
    },

    "OAUTH2_CLIENT_CREDENTIALS": {
      "flow": [
        "CLIENT_ID",
        "CLIENT_SECRET",
        "TOKEN_ENDPOINT",
        "ACCESS_TOKEN",
        "PROVIDER_API"
      ]
    },

    "OAUTH2_AUTHORIZATION_CODE": {
      "flow": [
        "AUTHORIZATION_REQUEST",
        "AUTHORIZATION_CODE",
        "TOKEN_EXCHANGE",
        "ACCESS_TOKEN",
        "PROVIDER_API"
      ]
    },

    "CERTIFICATE_AUTH": {
      "materials": [
        "X509_CERTIFICATE",
        "PRIVATE_KEY"
      ]
    }
  },

  "adapterContract": {
    "initialize": true,
    "authenticate": true,
    "healthCheck": true,
    "capabilities": true,
    "normalizeError": true,
    "normalizeResponse": true
  },

  "architecture": {
    "flow": [
      "PROVIDER_REGISTRY",
      "PROVIDER_ADAPTER",
      "AUTHENTICATION",
      "AUTHORIZED_API",
      "NORMALIZED_RESPONSE",
      "EVENT_OR_RESULT",
      "AUDIT"
    ]
  }
