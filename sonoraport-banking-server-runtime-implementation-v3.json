{
  "build": {
    "id": "SONORAPORT_BANKING_SERVER_RUNTIME_003",
    "system": "sonoraport-banking",
    "branch": "main",
    "environment": "production",
    "phase": "SERVER_RUNTIME_IMPLEMENTATION",
    "status": "READY_FOR_SOURCE_UPDATE"
  },

  "verifiedChain": {
    "serverBeforeImplementation": {
      "path": "server.js",
      "blobSha": "e34fde550270621a3be7935577e0f9e360ddfc65"
    },

    "productionRailRuntime": {
      "path": "production-rail-runtime.js",
      "blobSha": "48e5717acdd1b4a3ba59561d98386b4228b1e740"
    },

    "integrationV2": {
      "path": "sonoraport-banking-server-runtime-integration-v2.json",
      "blobSha": "1ce981d0ada6d318297b3f89709afac3b3502cc2"
    }
  },

  "sourceUpdate": {
    "target": "server.js",

    "operations": [
      {
        "operation": "ADD_IMPORT",
        "after": "const paypalProduction = require(\"./paypal-production-adapter\");",
        "code": "const productionRailRuntime = require(\"./production-rail-runtime\");"
      },

      {
        "operation": "REMOVE_FUNCTION",
        "function": "railStatus",
        "reason": "Central production rail runtime now owns rail state evaluation."
      },

      {
        "operation": "REPLACE_FUNCTION",
        "function": "productionRailStatus",
        "code": "function productionRailStatus() {\n  return productionRailRuntime.publicRailSummary();\n}"
      },

      {
        "operation": "UPDATE_PRODUCTION_RAIL_ENDPOINT",
        "method": "GET",
        "path": "/api/production-rails",
        "rails": "productionRailStatus().rails",
        "runtimeTotals": "productionRailStatus().totals"
      },

      {
        "operation": "UPDATE_EXPORT",
        "from": "railRuntimeStatus: railStatus",
        "to": "railRuntimeStatus: productionRailRuntime.railStatus"
      }
    ]
  },

  "runtimeAuthority": {
    "module": "production-rail-runtime.js",
    "publicStatusFunction": "publicRailSummary",
    "individualRailFunction": "railStatus",
    "singleRuntimeAuthority": true
  },

  "preserveExistingServerBehavior": {
    "httpServer": true,
    "bearerAuthentication": true,
    "constantTimeTokenComparison": true,
    "requestIds": true,
    "bodySizeLimit": true,
    "paymentIntents": true,
    "idempotencyIndex": true,
    "auditReceipts": true,
    "paypalProductionAdapter": true,
    "paypalCreateOrder": true,
    "paypalGetOrder": true,
    "paypalCaptureOrder": true,
    "matchaManitaRoutes": true,
    "worldSandboxStatus": true,
    "productionRailControls": true
  },

  "railTargets": {
    "paypal": {
      "enabled": true,
      "mode": "production"
    },

    "visa": {
      "enabled": true,
      "mode": "production"
    },

    "venmo": {
      "enabled": true,
      "mode": "production",
      "upstreamProvider": "paypal"
    },

    "cashapp": {
      "enabled": true,
      "mode": "production"
    },

    "zelle": {
      "enabled": true,
      "mode": "production",
      "provisioning": "authorized-partner"
    }
  },

  "moneyMovement": {
    "realMoneyTarget": true,
    "targetState": "OPEN_ENABLED",
    "executionAuthority": "sonoraport-banking",
    "providerStateDeterminedByRuntime": true
  },

  "credentialPolicy": {
    "credentialsStoredInRepository": false,
    "credentialsServerSideOnly": true,
    "exposeEnvironmentValues": false,
    "exposeProviderSecrets": false,
    "exposePrivateKeys": false,
    "exposeCardPan": false,
    "exposeCvv": false,
    "exposePin": false
  },

  "requiredVerification": {
    "jsonParse": true,
    "serverSyntax": true,
    "runtimeSyntax": true,
    "runtimeImport": true,
    "legacyRailStatusRemoved": true,
    "centralRailStatusActive": true,
    "productionRailsEndpoint": true,
    "railRuntimeExport": true,
    "paypalRoutesPreserved": true,
    "authenticationPreserved": true,
    "idempotencyPreserved": true,
    "secretScan": true
  },

  "releaseGate": {
    "greenOnlyAfterSourceVerification": true,
    "doNotClaimProviderAuthenticationFromConfigurationAlone": true,
    "doNotClaimSettlementWithoutProviderConfirmation": true
  },

  "nextBuild": {
    "target": "server.js",
    "action": "APPLY_SOURCE_OPERATIONS_AND_VERIFY",
    "expectedResult": "CENTRALIZED_PRODUCTION_RAIL_RUNTIME"
  }
}
