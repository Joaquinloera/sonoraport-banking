{
  "schemaVersion": "1.1.0",
  "recordType": "WORLDSANBOX13_BANKING_BRIDGE_STATUS_CONTROL",
  "status": "ACTIVE",
  "authority": {
    "masterFile": "worldsandbox13-sonoraport-banking-master.json",
    "readerControlFile": "worldsandbox13-banking-reader-control.json",
    "verificationFile": "worldsandbox13-banking-registry-verification.json",
    "accessManifestFile": "worldsandbox13-banking-access-manifest.json"
  },
  "source": {
    "repository": "Joaquinloera/Worldsanbox13",
    "branch": "main",
    "mode": "READ_ONLY"
  },
  "target": {
    "repository": "Joaquinloera/sonoraport-banking",
    "branch": "main",
    "service": "SONORAPORT_BANKING"
  },
  "bridge": {
    "id": "worldsanbox13-sonoraport-banking",
    "enabled": true,
    "readOnly": true,
    "failClosed": true,
    "expectedRegistryCount": 16
  },
  "endpoints": {
    "health": "/api/health",
    "capabilities": "/api/capabilities",
    "worldsanboxStatus": "/api/world-sandbox/status"
  },
  "statusRules": {
    "allowHardcodedConnected": false,
    "allowHardcodedAuthenticated": false,
    "allowHardcodedVerified": false,
    "connected": {
      "requiresRepositoryReachable": true,
      "requiresCorrectRepository": true,
      "requiresCorrectBranch": true
    },
    "verified": {
      "requiresMasterActive": true,
      "requiresReaderControlActive": true,
      "requiresVerificationControlActive": true,
      "requiresAccessManifestActive": true,
      "requiresExactRegistryCount": true,
      "requiresAllRegistriesReadable": true,
      "requiresAllRegistriesValidJson": true,
      "requiresProvenance": true,
      "requiredVerifiedRegistries": 16
    }
  },
  "capabilities": {
    "repositoryRead": true,
    "registryRead": true,
    "statusRead": true,
    "capabilityRead": true,
    "provenanceRead": true,
    "repositoryWrite": false,
    "registryWrite": false,
    "credentialRead": false,
    "secretRead": false,
    "directMoneyMovement": false,
    "unrestrictedTransfers": false
  },
  "authentication": {
    "serverSideOnly": true,
    "bridgeTokenEnvironmentVariable": "SONORAPORT_BANKING_BRIDGE_TOKEN",
    "githubTokenEnvironmentVariable": "WORLDSANDBOX13_GITHUB_TOKEN",
    "tokensStoredInJson": false,
    "tokensStoredInRepository": false
  },
  "runtimeVerification": {
    "configurationAloneProvesConnection": false,
    "requireLiveRepositoryRead": true,
    "requireLiveRegistryVerification": true,
    "requireVerifiedRegistryCount": 16,
    "requireFailedRegistryCount": 0
  },
  "responseContract": {
    "include": [
      "bridgeId",
      "mode",
      "repository",
      "branch",
      "connected",
      "verified",
      "expectedRegistryCount",
      "verifiedRegistryCount",
      "failedRegistryCount",
      "verificationState"
    ],
    "exclude": [
      "tokens",
      "passwords",
      "privateKeys",
      "credentials",
      "fullCardNumbers",
      "cvv"
    ]
  },
  "states": {
    "verified": "VERIFIED",
    "degraded": "DEGRADED",
    "blocked": "BLOCKED"
  },
  "checkpoint": {
    "requireLiveVerification": true,
    "requireZeroRegistryFailuresForVerified": true,
    "doNotTreatConfigurationAsRuntimeProof": true,
    "doNotTreatSourceReportedFinancialValuesAsExternallyVerified": true
  },
  "pipeline": [
    "LOAD_MASTER",
    "LOAD_READER_CONTROL",
    "LOAD_VERIFICATION_CONTROL",
    "LOAD_ACCESS_MANIFEST",
    "CHECK_REPOSITORY",
    "CHECK_BRANCH",
    "VERIFY_16_REGISTRIES",
    "VERIFY_PROVENANCE",
    "CALCULATE_STATUS",
    "REPORT_STATUS",
    "CHECKPOINT"
  ]
}
