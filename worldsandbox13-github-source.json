{
  "integration": {
    "id": "worldsanbox13",
    "type": "github_repository",
    "enabled": true,
    "required": true
  },
  "github": {
    "owner": "Joaquinloera",
    "repository": "Worldsanbox13",
    "fullName": "Joaquinloera/Worldsanbox13",
    "defaultBranch": "main",
    "readEnabled": true,
    "writeEnabled": false
  },
  "source": {
    "purpose": "SonoraPort Banking Worldsanbox13 registry source",
    "recursiveRead": true,
    "include": [
      "**/*.json"
    ],
    "exclude": [
      "**/.git/**",
      "**/node_modules/**",
      "**/.env",
      "**/.env.*"
    ]
  },
  "reader": {
    "provider": "github",
    "repository": "Joaquinloera/Worldsanbox13",
    "branch": "main",
    "mode": "read_only",
    "recursive": true,
    "failOnMissingRepository": true,
    "failOnAuthenticationError": true
  },
  "security": {
    "credentialsInJson": false,
    "githubTokenInJson": false,
    "allowSecrets": false,
    "requireAuthenticatedConnectorForPrivateRepository": true
  },
  "status": {
    "expected": "CONNECTED",
    "repositoryRequired": true
  }
}
