{
  "schemaVersion": "1.0.0",
  "recordType": "WORLDSANBOX13_STATUS_ENDPOINT_CONTRACT",
  "status": "ACTIVE",
  "service": "SONORAPORT_BANKING",

  "endpoint": {
    "method": "GET",
    "path": "/api/world-sandbox/status",
    "serverFile": "server.js",
    "authenticationRequired": false,
    "readOnly": true
  },

  "authoritativeRuntimeReader": {
    "path": "worldsandbox13-reader.js",
    "repositoryStatusFunction": "repositoryStatus",
    "registryVerificationFunction": "verifyApprovedRegistries",
    "required": true
  },

  "authoritativeSource": {
    "repository": "Joaquinloera/Worldsanbox13",
    "branch": "main",
    "mode": "READ_ONLY"
  },

  "registryControl": {
    "index": "worldsandbox13-registry-index.json",
    "expectedRegistryCount": 16,
    "requireExactCount": true,
    "requireUniqueRegistryIds": true,
    "requireUniqueRegistryPaths": true
  },

  "verification": {
    "repositoryReadRequired": true,
    "approvedRegistryReadRequired": true,
    "jsonParseRequired": true,
    "blobShaRequired": true,
    "provenanceRequired": true,
    "allApprovedRegistriesRequired": true,
    "configurationAloneProvesConnection": false,
    "hardcodedSuccessAllowed": false
  },

  "responseContract": {
    "requiredFields": [
      "service",
      "bridge",
      "status",
      "repository",
      "verification",
      "authority",
      "timestamp",
      "requestId"
    ],

    "bridge": "worldsandbox13",

    "allowedStatusValues": [
      "VERIFIED",
      "BLOCKED",
      "UNVERIFIED"
    ]
  },

  "verifiedState": {
    "status": "VERIFIED",
    "requirements": {
      "repositoryReadable": true,
      "approvedRegistryCountMatches": true,
      "allApprovedRegistriesReadable": true,
      "allApprovedRegistriesJsonValid": true,
      "allApprovedRegistriesHaveBlobSha": true
    }
  },

  "blockedState": {
    "status": "BLOCKED",
    "triggerOn": [
      "REPOSITORY_READ_FAILURE",
      "REGISTRY_NOT_APPROVED",
      "REGISTRY_PATH_FAILURE",
      "REGISTRY_READ_FAILURE",
      "INVALID_JSON",
      "MISSING_BLOB_SHA",
      "REGISTRY_COUNT_MISMATCH",
      "READER_FAILURE"
    ]
  },

  "unverifiedState": {
    "status": "UNVERIFIED",
    "usedWhen": [
      "RUNTIME_VERIFICATION_NOT_EXECUTED",
      "RUNTIME_RESULT_UNAVAILABLE"
    ]
  },

  "authority": {
    "statusRead": true,
    "capabilityRead": true,
    "registryRead": true,
    "registryWrite": false,
    "credentialRead": false,
    "secretRead": false,
    "unrestrictedTransfers": false
  },

  "security": {
    "returnCredentialValues": false,
    "returnSecretValues": false,
    "returnAuthenticationTokens": false,
    "exposeEnvironmentValues": false,
    "serverSideOnly": true
  },

  "environmentVariableNames": {
    "worldsanboxGithubToken": "WORLDSANDBOX13_GITHUB_TOKEN"
  },

  "ciRequirements": {
    "endpointMustRespond": true,
    "readerBackedVerificationRequired": true,
    "hardcodedAvailableResponseMustFail": true,
    "blockedReaderMustNotReturnVerified": true,
    "registryCountMustBeValidated": true
  },

  "currentState": {
    "serverReaderWiringVerified": false,
    "readerBackedEndpointVerified": false,
    "state": "UNVERIFIED"
  },

  "failClosed": true
}
