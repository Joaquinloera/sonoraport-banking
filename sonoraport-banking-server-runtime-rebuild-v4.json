{
  "build_id": "SONORAPORT_BANKING_SERVER_RUNTIME_004",
  "version": 4,
  "project": "SONORAPORT BANKING",
  "repository": "Joaquinloera/sonoraport-banking",
  "branch": "main",
  "environment": "production",
  "execution_authority": "sonoraport-banking",

  "runtime": {
    "entrypoint": "server.js",
    "rail_runtime": "production-rail-runtime.js",
    "api_version": "1.3.0",
    "node_target": "20.x"
  },

  "server_runtime": {
    "host_env": "HOST",
    "port_env": "PORT",
    "default_host": "0.0.0.0",
    "default_port": 3100,
    "max_body_bytes": 65536,
    "request_id": "crypto.randomUUID",
    "environment": "production"
  },

  "production_rail_runtime": {
    "enabled": true,
    "module": "./production-rail-runtime",
    "single_source_of_truth": true,
    "status_export": "railStatus",
    "public_summary_export": "publicRailSummary",
    "legacy_server_rail_status_removed": true,
    "rails": [
      "paypal",
      "visa",
      "venmo",
      "cashapp",
      "zelle"
    ]
  },

  "rail_verification_model": {
    "registered": true,
    "configured_requires_environment": true,
    "authenticated_requires_provider_confirmation": true,
    "provider_verified_requires_provider_confirmation": true,
    "settlement_verified_requires_provider_confirmation": true,
    "fabricated_provider_status_forbidden": true,
    "fabricated_settlement_status_forbidden": true
  },

  "paypal": {
    "enabled": true,
    "adapter": "./paypal-production-adapter",
    "routes": [
      "GET /api/paypal/status",
      "POST /api/paypal/orders",
      "GET /api/paypal/orders/:providerOrderId",
      "POST /api/paypal/orders/:providerOrderId/capture"
    ],
    "idempotency_header": "Idempotency-Key",
    "provider_request_id": "PayPal-Request-Id",
    "provider_confirmation_required": true,
    "unverified_settlement_allowed": false
  },

  "matcha_manita_banking_boundary": {
    "enabled": true,
    "server_side_only": true,
    "routes": [
      "POST /api/matcha-manita/payment-intents",
      "GET /api/matcha-manita/payment-intents/:id",
      "POST /api/matcha-manita/payment-intents/:id/cancel",
      "GET /api/matcha-manita/payment-intents/:id/receipt"
    ],
    "authentication": {
      "type": "Bearer",
      "environment_variable": "MATCHA_MANITA_BANKING_TOKEN",
      "timing_safe_comparison": true,
      "hardcoded_credentials": false
    },
    "idempotency": {
      "required": true,
      "header": "Idempotency-Key",
      "fingerprint": "SHA-256",
      "conflict_on_key_reuse_with_different_request": true
    },
    "audit": {
      "enabled": true,
      "protocol": "SONORAPORT-AUDIT-1",
      "digest": "SHA-256"
    },
    "provider_confirmation_required": true,
    "private_credentials_in_browser": false
  },

  "core_routes": [
    "GET /",
    "GET /api/health",
    "GET /api/capabilities",
    "GET /api/production-rails",
    "GET /api/world-sandbox/status"
  ],

  "production_rails_endpoint": {
    "route": "GET /api/production-rails",
    "summary_source": "productionRailRuntime.publicRailSummary()",
    "rails_source": "railSummary.rails",
    "runtime_source": "railSummary.totals",
    "preserve_execution_authority": true,
    "preserve_controls": true,
    "preserve_timestamp": true,
    "preserve_request_id": true
  },

  "worldsandbox13": {
    "status_route": "GET /api/world-sandbox/status",
    "status_read": true,
    "capability_read": true,
    "credential_read": false,
    "unrestricted_transfers": false
  },

  "security": {
    "environment_credentials_only": true,
    "hardcoded_passwords": false,
    "hardcoded_private_keys": false,
    "hardcoded_provider_secrets": false,
    "hardcoded_banking_bearer_tokens": false,
    "hardcoded_pan": false,
    "hardcoded_cvv": false,
    "hardcoded_pin": false,
    "hardcoded_webhook_secrets": false,
    "timing_safe_token_comparison": true,
    "body_size_limit_required": true,
    "invalid_json_handling_required": true
  },

  "required_source_contracts": [
    "require ./production-rail-runtime",
    "remove local function railStatus(id)",
    "productionRailStatus returns productionRailRuntime.publicRailSummary()",
    "production rails endpoint uses railSummary.rails",
    "production rails endpoint uses railSummary.totals",
    "preserve PayPal routes",
    "preserve MATCHA MANITA banking routes",
    "preserve timing-safe Bearer authentication",
    "preserve idempotency index",
    "preserve audit receipts",
    "preserve SONORAPORT-AUDIT-1",
    "preserve MAX_BODY_BYTES",
    "preserve INVALID_JSON",
    "preserve BODY_TOO_LARGE",
    "preserve WorldSandbox status endpoint",
    "preserve server.listen",
    "preserve module.exports"
  ],

  "verification": {
    "required_commands": [
      "node --check server.js",
      "node --check production-rail-runtime.js"
    ],
    "server_syntax_exit_code_required": 0,
    "runtime_syntax_exit_code_required": 0,
    "security_scan_required": true,
    "github_fetch_back_required": true
  },

  "manual_upload": {
    "owner_uploads_files": true,
    "agent_git_push": false,
    "replace_root_server_js": true
  },

  "green_gate": {
    "syntax_pass_required": true,
    "static_contract_pass_required": true,
    "security_pass_required": true,
    "manual_upload_required": true,
    "uploaded_source_fetch_back_required": true,
    "green_before_fetch_back": false
  }
}
