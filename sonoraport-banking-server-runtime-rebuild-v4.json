  "sourceOperations": [
    {
      "operation": "ADD_IMPORT",
      "target": "server.js",
      "after": "const paypalProduction = require(\"./paypal-production-adapter\");",
      "code": "const productionRailRuntime = require(\"./production-rail-runtime\");"
    },
    {
      "operation": "REMOVE_LEGACY_FUNCTION",
      "function": "railStatus",
      "reason": "production-rail-runtime.js owns centralized rail state evaluation"
    },
    {
      "operation": "REPLACE_FUNCTION",
      "function": "productionRailStatus",
      "code": "function productionRailStatus() {\n  return productionRailRuntime.publicRailSummary();\n}"
    },
    {
      "operation": "UPDATE_ENDPOINT",
      "method": "GET",
      "path": "/api/production-rails",
      "summary": "const railSummary = productionRailStatus();",
      "railsSource": "railSummary.rails",
      "runtimeTotalsSource": "railSummary.totals"
    },
    {
      "operation": "UPDATE_EXPORT",
      "from": "railRuntimeStatus: railStatus",
      "to": "railRuntimeStatus: productionRailRuntime.railStatus"
    }
  ],

  "preserve": [
