{
  "schemaVersion": "1.1.0",
  "recordType": "SONORAPORT_CARD_DISPUTE_CHARGEBACK_CONTROL",
  "status": "ACTIVE",
  "service": "SONORAPORT_BANKING",
  "authority": {
    "integrationControl": "sonoraport-card-payment-integration-control.json",
    "providerManifest": "sonoraport-card-provider-api-manifest.json",
    "runtimeVerification": "sonoraport-card-runtime-verification.json",
    "transactionControl": "sonoraport-card-webhook-transaction-control.json",
    "tokenizationBoundary": "sonoraport-card-tokenization-data-boundary.json",
    "settlementControl": "sonoraport-card-settlement-reconciliation-control.json"
  },
  "disputeStates": [
    "OPENED",
    "EVIDENCE_REQUIRED",
    "EVIDENCE_SUBMITTED",
    "UNDER_REVIEW",
    "WON",
    "LOST",
    "CLOSED"
  ],
  "disputes": {
    "enabled": true,
    "requireOriginalTransactionReference": true,
    "requireProviderDisputeReference": true,
    "preserveProviderReasonCode": true,
    "preserveProviderStatus": true,
    "providerConfirmationRequiredForOutcome": true,
    "doNotInventOutcome": true
  },
  "chargebacks": {
    "enabled": true,
    "requireOriginalTransactionReference": true,
    "requireProviderReference": true,
    "requireProviderConfirmation": true,
    "preserveAmount": true,
    "preserveCurrency": true,
    "doNotTreatOpenedAsLost": true
  },
  "evidence": {
    "enabled": true,
    "requireEvidenceReference": true,
    "requireSubmissionTimestamp": true,
    "preserveProviderSubmissionReference": true
  },
  "reversals": {
    "enabled": true,
    "requireOriginalTransactionReference": true,
    "requireProviderReversalReference": true,
    "requireProviderConfirmation": true,
    "preserveReversalAmount": true
  },
  "webhooks": {
    "enabled": true,
    "signatureVerificationRequired": true,
    "rejectInvalidSignature": true,
    "idempotencyRequired": true,
    "deduplicateProviderEvents": true
  },
  "reconciliation": {
    "enabled": true,
    "compareAmount": true,
    "compareCurrency": true,
    "compareProviderStatus": true,
    "compareInternalStatus": true,
    "flagMismatch": true,
    "inventMissingValues": false
  },
  "security": {
    "tokenizationRequired": true,
    "storeFullPan": false,
    "storeCvv": false,
    "storePin": false,
    "storeApiKeys": false,
    "storeWebhookSecrets": false,
    "repositorySecretsAllowed": false,
    "credentialsFromEnvironmentOnly": true
  },
  "verification": {
    "configurationAloneProvesDisputeStatus": false,
    "requireLiveProviderStatus": true,
    "requireProviderReference": true,
    "requireReconciliation": true
  },
  "worldsanbox13": {
    "mode": "READ_ONLY",
    "allowRawCardImport": false,
    "allowCredentialImport": false,
    "allowSecretImport": false,
    "preserveSourceReportedValues": true
  },
  "runtimeStatus": {
    "initialState": "UNVERIFIED",
    "successState": "VERIFIED",
    "failureState": "BLOCKED"
  },
  "pipeline": [
    "RECEIVE_DISPUTE_EVENT",
    "VERIFY_SIGNATURE",
    "VERIFY_PROVIDER_REFERENCE",
    "MATCH_ORIGINAL_TRANSACTION",
    "RECORD_DISPUTE_STATE",
    "PROCESS_EVIDENCE",
    "VERIFY_PROVIDER_OUTCOME",
    "RECONCILE",
    "REPORT_STATUS",
    "CHECKPOINT"
  ],
  "failClosed": true
}
